# Banco
DB_NAME=vagamatch
DB_USER=vagamatch
DB_PASSWORD=vagamatch

# RabbitMQ
RABBIT_USER=vagamatch
RABBIT_PASSWORD=vagamatch

# Gemini (analise-service). Os serviços leem este .env sozinhos (spring.config.import).
GEMINI_API_KEY=sua-chave-aqui
# Opcional: troca o modelo (padrão gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# Opcional: modelos usados quando o principal responde 503, separados por vírgula
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
